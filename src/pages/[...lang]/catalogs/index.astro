---
import { languages, type Language } from '../../../types/content';
import { catalogGroups } from '../../../lib/catalog-groups';
import BaseLayout from '../../../layouts/BaseLayout.astro';
export function getStaticPaths(){return languages.map(lang=>({params:{lang:lang==='es'?undefined:lang}}));}
const lang=(Astro.params.lang??'es') as Language;
const title=lang==='es'?'Catálogos':'Catalogs';
const description=lang==='es'?'Explora nuestros catálogos por tipo de empaque.':'Explore our catalogs by packaging type.';
---
<BaseLayout lang={lang} path="catalogs" title={title} description={description}>
  <section class="page-heading site-container"><div class="centered-intro"><h1>{title}</h1><p>{description}</p></div></section>
  <section class="section site-container catalogs-grid">
    {catalogGroups.map(group=><section id={group.id}><h2>{group.title[lang]}</h2>
      {group.downloads.map(c=><a class="text-link" href={c.url[lang]} target="_blank" rel="noopener noreferrer">{c.title[lang]} ↗</a>)}
    </section>)}
  </section>
</BaseLayout>
