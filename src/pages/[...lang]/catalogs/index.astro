---
import { languages, type Language } from '../../../types/content';
import { visibleCategories, publishedCatalogs } from '../../../lib/data';
import { route } from '../../../lib/routes';
import BaseLayout from '../../../layouts/BaseLayout.astro';
export function getStaticPaths(){return languages.map(lang=>({params:{lang:lang==='es'?undefined:lang}}));}
const lang=(Astro.params.lang??'es') as Language;
const title=lang==='es'?'Catálogos':'Catalogs';
const description=lang==='es'?'Explora nuestros catálogos por tipo de empaque.':'Explore our catalogs by packaging type.';
const ungrouped=publishedCatalogs.filter(c=>!c.categoryIds.length);
---
<BaseLayout lang={lang} path="catalogs" title={title} description={description}>
  <section class="page-heading site-container"><div class="centered-intro"><h1>{title}</h1><p>{description}</p></div></section>
  <section class="section site-container catalogs-grid">
    {visibleCategories.map(category=><section id={category.id}><h2>{category.title[lang]}</h2>
      {publishedCatalogs.filter(c=>c.categoryIds.includes(category.id)).map(c=><a class="text-link" href={c.url} target="_blank" rel="noopener noreferrer">{c.title[lang]} ↗</a>)}
      {!publishedCatalogs.some(c=>c.categoryIds.includes(category.id))&&<p>{lang==='es'?'Catálogos disponibles próximamente.':'Catalogs coming soon.'}</p>}
      <a class="text-link" href={route(lang,`products/categories/${category.slug}`)}>{lang==='es'?'Explorar productos':'Explore products'} →</a>
    </section>)}
    {ungrouped.length>0&&<section><h2>{lang==='es'?'Otros catálogos':'Other catalogs'}</h2>{ungrouped.map(c=><a href={c.url} target="_blank" rel="noopener noreferrer">{c.title[lang]} ↗</a>)}</section>}
  </section>
</BaseLayout>
