---
import { languages, type Language } from '../../../types/content';
import { publishedCases } from '../../../lib/data';
import { ui } from '../../../i18n/ui';
import { route } from '../../../lib/routes';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InteriorBanner from '../../../components/sections/InteriorBanner.astro';
import MediaPlaceholder from '../../../components/ui/MediaPlaceholder.astro';
import { editorialMedia } from '../../../lib/editorial-media';
export function getStaticPaths(){return languages.map(lang=>({params:{lang:lang==='es'?undefined:lang}}));}
const lang=(Astro.params.lang ?? 'es') as Language;const t=ui(lang);
---
<BaseLayout lang={lang} path="case-studies" title={t.cases} description={t.casesPending} noindex={publishedCases.length===0}>
  <InteriorBanner lang={lang} title={t.cases}/><section class="section site-container"><div class="empty-section"><h2>{lang==='es'?'Diseño que toma forma':'Design taking shape'}</h2><p class="mt-6">{t.casesPending}</p><MediaPlaceholder lang={lang} media={editorialMedia.design} ratio={2}/><a class="button" href={route(lang,'contact')}>{t.contact}</a></div></section>
</BaseLayout>
