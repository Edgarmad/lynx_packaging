---
import { languages, type Language } from '../../../types/content';
import { visibleSolutions, solutionsOverview } from '../../../lib/data';
import { ui } from '../../../i18n/ui';
import { route } from '../../../lib/routes';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InteriorBanner from '../../../components/sections/InteriorBanner.astro';
import EditorialBlock from '../../../components/sections/EditorialBlock.astro';
import { editorialMedia } from '../../../lib/editorial-media';
export function getStaticPaths(){return languages.map(lang=>({params:{lang:lang==='es'?undefined:lang}}));}
const lang=(Astro.params.lang ?? 'es') as Language;const t=ui(lang);
---
<BaseLayout lang={lang} path="solutions" title={t.solutions} description={lang==='es'?'Las siete soluciones por sector de Lynx Packaging.':'The seven Lynx Packaging industry solutions.'}>
  <InteriorBanner lang={lang} title={t.solutions} description={solutionsOverview.intro[lang]} media={editorialMedia['solutions-banner']}/>
  <section class="section site-container">
    <div class="centered-intro">
      <h2>{solutionsOverview.title[lang]}</h2>
    </div>
    {visibleSolutions.map((solution,index)=><EditorialBlock lang={lang} title={solution.title[lang]} description={solution.description[lang]} media={solution.media} reverse={index%2!==0} href={route(lang,`solutions/${solution.slug}`)} cta={t.learn}/>)}
  </section>
</BaseLayout>
