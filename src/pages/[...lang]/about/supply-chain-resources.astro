---
import { languages, type Language } from '../../../types/content';
import { supply } from '../../../lib/data';
import { abilityUi } from '../../../i18n/ability';
import { editorialMedia } from '../../../lib/editorial-media';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InteriorBanner from '../../../components/sections/InteriorBanner.astro';
import AbilityContact from '../../../components/sections/AbilityContact.astro';
import MediaPlaceholder from '../../../components/ui/MediaPlaceholder.astro';
export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang: lang === 'es' ? undefined : lang } }));
}
const lang = (Astro.params.lang ?? 'es') as Language;
const t = abilityUi(lang);
---
<BaseLayout lang={lang} path="about/supply-chain-resources" title={supply.title[lang]} description={supply.intro[lang]}>
  <InteriorBanner lang={lang} title={supply.title[lang]} media={editorialMedia['supplier-campus']} parent={{ title: t.about, path: 'about/overview' }} />
  <section class="section site-container ability-intro">
    <div class="centered-intro">
      <h2>{t.supplyIntro}</h2>
      <p>{supply.intro[lang]}</p>
    </div>
  </section>
  <div class="supply-resources">
    {supply.resources.map((resource, index) => <section class="supplier-resource section" aria-labelledby={`${resource.id}-title`}>
      <div class="site-container">
        <div class="supplier-resource-heading">
          <div><span class="eyebrow">{t.supplyLabel} / {String(index + 1).padStart(2, '0')}</span><h2 id={`${resource.id}-title`}>{resource.title[lang]}</h2></div>
          <p>{resource.description[lang]}</p>
        </div>
        <div class:list={['supplier-gallery', { 'supplier-gallery-three': resource.gallery.length === 3 }]}>
          {resource.gallery.map(media => <MediaPlaceholder lang={lang} media={media} />)}
        </div>
      </div>
    </section>)}
  </div>
  <AbilityContact lang={lang} related="service" />
</BaseLayout>
