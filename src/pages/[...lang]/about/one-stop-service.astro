---
import { languages, type Language } from '../../../types/content';
import { service, publishedCases } from '../../../lib/data';
import { abilityUi } from '../../../i18n/ability';
import { route } from '../../../lib/routes';
import { editorialMedia } from '../../../lib/editorial-media';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InteriorBanner from '../../../components/sections/InteriorBanner.astro';
import AbilityContact from '../../../components/sections/AbilityContact.astro';
import MediaPlaceholder from '../../../components/ui/MediaPlaceholder.astro';
export function getStaticPaths() {
  return languages.map(lang => ({ params: { lang: lang === 'es' ? undefined : lang } }));
}
const lang = (Astro.params.lang ?? 'es') as Language;
const t = abilityUi(lang);
---
<BaseLayout lang={lang} path="about/one-stop-service" title={service.title[lang]} description={service.intro[lang]}>
  <InteriorBanner lang={lang} title={service.title[lang]} media={editorialMedia.design} parent={{ title: t.about, path: 'about/overview' }} />
  <section class="section site-container ability-intro">
    <div class="centered-intro">
      <h2>{t.serviceIntro}</h2>
      <p>{service.pageIntro[lang]}</p>
    </div>
    <nav class="service-process" aria-label={t.processLabel}>
      <ol>
        {service.stages.map((stage, index) => <li><a href={`#${stage.id}`}><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{stage.title[lang]}</a></li>)}
      </ol>
    </nav>
  </section>
  <div class="service-sections">
    {service.stages.map((stage, index) => <section class:list={['service-stage', { 'service-stage-soft': index % 2 !== 0 }]} id={stage.id} aria-labelledby={`${stage.id}-title`}>
      <div class:list={['site-container alternating-section', { reverse: index % 2 !== 0 }]}>
        <div class="section-copy">
          <span class="eyebrow">{String(index + 1).padStart(2, '0')} / {String(service.stages.length).padStart(2, '0')}</span>
          <h2 id={`${stage.id}-title`}>{stage.title[lang]}</h2>
          {stage.paragraphs.map(paragraph => <p>{paragraph[lang]}</p>)}
          {stage.caseIds.some(id => publishedCases.some(item => item.id === id)) && <a class="text-link" href={route(lang, 'case-studies')}>{t.designCases}<span aria-hidden="true">→</span></a>}
        </div>
        <MediaPlaceholder lang={lang} media={stage.media} />
      </div>
    </section>)}
  </div>
  <AbilityContact lang={lang} related="resources" />
</BaseLayout>
