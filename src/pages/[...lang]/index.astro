---
import { languages, type Language } from '../../types/content';
import { home, visibleCategories, visibleProducts, visibleSolutions, service } from '../../lib/data';
import { route } from '../../lib/routes';
import { ui } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaPlaceholder from '../../components/ui/MediaPlaceholder.astro';
import ProductCarousel from '../../components/products/ProductCarousel.astro';
export function getStaticPaths(){return languages.map(lang=>({params:{lang:lang==='es'?undefined:lang}}));}
const lang=(Astro.params.lang ?? 'es') as Language;const t=ui(lang);
---
<BaseLayout lang={lang} path="" title={lang==='es'?'Inicio':'Home'} description={home.intro[lang]} home>
  <section class="hero"><MediaPlaceholder lang={lang} media={home.hero} class="hero-media"/><div class="site-container hero-content"><h1>{home.title[lang]}</h1></div></section>
  <section class="section site-container"><div class="centered-intro"><h2>{home.introTitle[lang]}</h2><p>{home.intro[lang]}</p><a class="button" href={route(lang,'about/overview')}>{t.learn}<span aria-hidden="true">→</span></a></div></section>
  <section class="section home-product-section site-container" data-category-showcase>
    <h2 class="text-center">{t.products}</h2><p class="demo-note">{t.categoryDemo}</p>
    <div class="category-tabs" role="tablist" aria-label={t.products} hidden data-category-tabs>{visibleCategories.map((category,index)=><button id={`tab-${category.id}`} role="tab" aria-selected={index===0?'true':'false'} aria-controls={`panel-${category.id}`} tabindex={index===0?0:-1}>{category.title[lang]}</button>)}</div>
    {visibleCategories.map(category=><div id={`panel-${category.id}`} role="tabpanel" aria-labelledby={`tab-${category.id}`} data-category-panel><h3 data-nojs-title>{category.title[lang]}</h3><ProductCarousel lang={lang} products={visibleProducts.filter(p=>p.categoryIds.includes(category.id))} id={`carousel-${category.id}`}/><a class="text-link mt-6" href={route(lang,`products/categories/${category.slug}`)}>{t.explore}<span aria-hidden="true">→</span></a></div>)}
  </section>
  <section class="capability-section"><MediaPlaceholder lang={lang} kind="video" ratio={2.2}/><div class="site-container capability-content"><h2>{t.service}</h2><p>{service.intro[lang]}</p><a class="text-link" href={route(lang,'about/one-stop-service')}>{t.learn}<span aria-hidden="true">→</span></a></div><div class="site-container service-stages-strip">{service.stages.map(stage=><span>{stage.title[lang]}</span>)}</div></section>
  <section class="section site-container"><div class="centered-intro"><h2>{t.solutions}</h2></div><div class="solution-links">{visibleSolutions.map(solution=><a class="text-link" href={route(lang,`solutions/${solution.slug}`)}>{solution.title[lang]}<span aria-hidden="true">→</span></a>)}</div></section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-category-showcase]').forEach(root=>{
    const bar=root.querySelector<HTMLElement>('[data-category-tabs]');if(bar)bar.hidden=false;
    root.querySelectorAll<HTMLElement>('[data-nojs-title]').forEach(el=>el.hidden=true);
    const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));const panels=Array.from(root.querySelectorAll<HTMLElement>('[data-category-panel]'));
    const select=(index:number)=>{tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;});panels.forEach((panel,i)=>panel.hidden=i!==index);};
    tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(index));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();select(next);tabs[next]?.focus();});});select(0);
  });
</script>
