---
import { navigation, visibleCategories, visibleSolutions, publishedCatalogs, site } from '../../lib/data';
import { route, alternate } from '../../lib/routes';
import { ui } from '../../i18n/ui';
import type { Language } from '../../types/content';
interface Props { lang: Language; path: string; home?: boolean; }
const {lang,path,home=false} = Astro.props;
const t=ui(lang);
function children(group: string | null): {title:string;href:string;external?:boolean}[] {
  switch(group) {
    case 'about': return [{title:t.overview,href:route(lang,'about/overview')}];
    case 'products': return visibleCategories.map(c=>({title:c.title[lang]+(c.status==='demo' ? (lang==='es' ? ' · demo' : ' · demo') : ''),href:route(lang,`products/categories/${c.slug}`)}));
    case 'solutions': return visibleSolutions.map(s=>({title:s.title[lang],href:route(lang,`solutions/${s.slug}`)}));
    case 'catalogs': return publishedCatalogs.map(c=>({title:c.title[lang],href:c.url,external:true}));
    default: return [];
  }
}
---
<header class:list={['site-header', {'home-header':home}]} id="site-header">
  <div class="header-inner">
    <a href={route(lang)} class="logo-link" aria-label="Lynx Packaging">
      <img class="logo-default" src={site.logo} alt="" width="2000" height="2000" />
      <img class="logo-on-white" src={site.logoOnWhite} alt="" width="2000" height="2000" />
    </a>
    <nav class="desktop-nav" aria-label={lang==='es'?'Navegación principal':'Main navigation'}>
      {navigation.map(item => <div class:list={['nav-item',{active:item.path && path.startsWith(item.path.split('/')[0])}]}>
        <div class="nav-item-controls">
          {item.path && <a href={route(lang,item.path)} aria-current={path===item.path?'page':undefined}>{item.title[lang]}</a>}
          {item.group && <button class:list={['menu-disclosure',{'menu-label':!item.path}]} aria-expanded="false" aria-controls={`mega-${item.id}`} aria-label={`${item.title[lang]}: ${lang==='es'?'abrir submenú':'open submenu'}`}>{item.path ? <span class="disclosure-text">{lang==='es'?'Abrir submenú':'Open submenu'}</span> : item.title[lang]}</button>}
        </div>
        {item.group && <div id={`mega-${item.id}`} class="mega-menu" hidden>
          <div class="site-container mega-inner"><p class="mega-title">{item.title[lang]}</p><div class="mega-links">
            {item.path && <a class="text-link" href={route(lang,item.path)}>{lang==='es'?'Ver resumen':'View overview'}</a>}
            {children(item.group).map(child=><a href={child.href} target={child.external?'_blank':undefined} rel={child.external?'noopener noreferrer':undefined}>{child.title}</a>)}
            {item.group==='catalogs' && !publishedCatalogs.length && <p>{t.catalogsPending}</p>}
          </div></div>
        </div>}
      </div>)}
    </nav>
    <a class="language-switch" href={alternate(lang,path)} lang={lang==='es'?'en':'es'} aria-label={lang==='es'?'View this page in English':'Ver esta página en español'}><span class:list={{'current-language':lang==='es'}}>ES</span><span aria-hidden="true">/</span><span class:list={{'current-language':lang==='en'}}>EN</span></a>
    <button class="mobile-toggle" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-menu"><span aria-hidden="true">☰</span></button>
  </div>
  <nav id="mobile-menu" class="mobile-nav" aria-label={lang==='es'?'Menú móvil':'Mobile menu'} hidden>
    <div class="mobile-menu-heading"><span>{lang==='es'?'Menú':'Menu'}</span><button data-mobile-close aria-label={t.close}>×</button></div>
    {navigation.map(item=> item.group ? <details><summary>{item.title[lang]}</summary><div class="mobile-links">
      {item.path && <a href={route(lang,item.path)}>{lang==='es'?'Ver resumen':'View overview'} →</a>}
      {children(item.group).map(child=><a href={child.href} target={child.external?'_blank':undefined} rel={child.external?'noopener noreferrer':undefined}>{child.title} {child.external?'↗':'→'}</a>)}
      {item.group==='catalogs'&&!publishedCatalogs.length&&<p>{t.catalogsPending}</p>}
    </div></details> : <a class="mobile-direct" href={route(lang,item.path??'')}>{item.title[lang]} →</a>)}
  </nav>
</header>
<script>
  const header=document.querySelector<HTMLElement>('#site-header');
  if(header){
    const toggles=Array.from(header.querySelectorAll<HTMLButtonElement>('.menu-disclosure'));
    function closeMenus(){toggles.forEach(button=>{button.setAttribute('aria-expanded','false');const panel=document.getElementById(button.getAttribute('aria-controls')??'');if(panel)panel.hidden=true;});}
    let hoverTimer:ReturnType<typeof setTimeout>|undefined;
    toggles.forEach(button=>button.addEventListener('click',()=>{clearTimeout(hoverTimer);const open=button.getAttribute('aria-expanded')==='true';closeMenus();if(!open){button.setAttribute('aria-expanded','true');const panel=document.getElementById(button.getAttribute('aria-controls')??'');if(panel)panel.hidden=false;}}));
    document.addEventListener('click',event=>{if(event.target instanceof Node&&!header.contains(event.target))closeMenus();});
    header.addEventListener('focusout',event=>{if(event.relatedTarget instanceof Node&&!header.contains(event.relatedTarget))closeMenus();});
    const openMenu=(button:HTMLButtonElement)=>{closeMenus();button.setAttribute('aria-expanded','true');const panel=document.getElementById(button.getAttribute('aria-controls')??'');if(panel)panel.hidden=false;};
    const hover=window.matchMedia('(hover: hover) and (pointer: fine)');
    let leaveTimer:ReturnType<typeof setTimeout>|undefined;
    header.querySelectorAll<HTMLElement>('.nav-item').forEach(item=>{
      item.addEventListener('pointerenter',()=>{if(!hover.matches)return;clearTimeout(leaveTimer);clearTimeout(hoverTimer);const button=item.querySelector<HTMLButtonElement>('.menu-disclosure');hoverTimer=setTimeout(()=>{if(button)openMenu(button);else closeMenus();},120);});
    });
    header.addEventListener('pointerenter',()=>clearTimeout(leaveTimer));
    header.addEventListener('pointerleave',()=>{clearTimeout(hoverTimer);if(hover.matches)leaveTimer=setTimeout(()=>{if(!header.contains(document.activeElement))closeMenus();},180);});
    const toggle=header.querySelector<HTMLButtonElement>('.mobile-toggle');
    const mobile=header.querySelector<HTMLElement>('#mobile-menu');
    const closeMobile=()=>{if(mobile)mobile.hidden=true;toggle?.setAttribute('aria-expanded','false');document.body.classList.remove('menu-open');};
    toggle?.addEventListener('click',()=>{if(!mobile)return;const open=!mobile.hidden;closeMobile();closeMenus();if(!open){mobile.hidden=false;toggle.setAttribute('aria-expanded','true');document.body.classList.add('menu-open');mobile.querySelector<HTMLButtonElement>('button')?.focus();}});
    mobile?.querySelectorAll('details').forEach(detail=>detail.addEventListener('toggle',()=>{if(detail.open)mobile.querySelectorAll('details').forEach(other=>{if(other!==detail)other.open=false;});}));
    header.querySelector('[data-mobile-close]')?.addEventListener('click',()=>{closeMobile();toggle?.focus();});
    document.addEventListener('keydown',event=>{
      if(event.key==='Escape'){const active=toggles.find(b=>b.getAttribute('aria-expanded')==='true');closeMenus();active?.focus();if(mobile&&!mobile.hidden){closeMobile();toggle?.focus();}}
      if(event.key==='Tab'&&mobile&&!mobile.hidden){const focusable=Array.from(mobile.querySelectorAll<HTMLElement>('a,button,summary')).filter(el=>el.getClientRects().length>0);const first=focusable[0];const last=focusable.at(-1);if(event.shiftKey&&document.activeElement===first){event.preventDefault();last?.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first?.focus();}}
    });
    const onScroll=()=>header.classList.toggle('scrolled',window.scrollY>32);onScroll();window.addEventListener('scroll',onScroll,{passive:true});
    const breakpoint=window.matchMedia('(min-width: 1100px)');breakpoint.addEventListener('change',()=>{closeMobile();closeMenus();});
  }
</script>
