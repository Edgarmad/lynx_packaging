---
import { catalogGroups as groups } from '../../lib/catalog-groups';
import type { Language } from '../../types/content';
interface Props { lang: Language; }
const {lang}=Astro.props;
---
<div class="catalog-menu-groups">
  {groups.map(group=><details><summary>{group.title[lang]}</summary><div class="catalog-menu-downloads">
    {group.downloads.map(download=>download.url[lang]?<a href={download.url[lang]} target="_blank" rel="noopener noreferrer">{download.title[lang]}</a>:<span class="catalog-download-slot">{download.title[lang]}</span>)}
  </div></details>)}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.catalog-menu-groups').forEach(groups=>{
    const hover=window.matchMedia('(min-width:1100px) and (hover:hover) and (pointer:fine)');
    const resize=()=>{
      const downloads=groups.querySelector<HTMLElement>('details[open] > .catalog-menu-downloads');
      groups.style.setProperty('--catalog-download-height',`${downloads?.getBoundingClientRect().height??0}px`);
    };
    const observer=new ResizeObserver(resize);
    groups.querySelectorAll<HTMLDetailsElement>(':scope > details').forEach(detail=>{
    const activate=()=>{detail.parentElement?.querySelectorAll<HTMLDetailsElement>(':scope > details').forEach(other=>{if(other!==detail)other.open=false;});};
    detail.addEventListener('toggle',()=>{if(detail.open)activate();resize();});
    // Only category labels activate hover; crossing the downloads keeps them open.
    detail.querySelector('summary')?.addEventListener('pointerenter',()=>{
      if(!hover.matches)return;
      activate();detail.open=true;resize();
    });
    const downloads=detail.querySelector('.catalog-menu-downloads');
    if(downloads)observer.observe(downloads);
    });
    hover.addEventListener('change',resize);
  });
</script>
