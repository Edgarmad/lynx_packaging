---
import { catalogGroups as groups } from '../../lib/catalog-groups';
import type { Language } from '../../types/content';
interface Props { lang: Language; }
const {lang}=Astro.props;
---
<div class="catalog-menu-groups">
  {groups.map(group=><details><summary>{group.title[lang]}</summary><div class="catalog-menu-downloads">
    {group.downloads.map(download=>download.url[lang]?<a href={download.url[lang]} target="_blank" rel="noopener noreferrer">{download.title[lang]}</a>:<span class="catalog-download-slot">{download.title[lang]}</span>)}
  </div></details>)}
</div>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.catalog-menu-groups > details').forEach(detail=>{
    const activate=()=>{detail.parentElement?.querySelectorAll<HTMLDetailsElement>(':scope > details').forEach(other=>{if(other!==detail)other.open=false;});};
    detail.addEventListener('toggle',()=>{if(detail.open)activate();});
    detail.addEventListener('pointerenter',()=>{if(window.matchMedia('(min-width:1100px) and (hover:hover)').matches){activate();detail.open=true;}});
  });
</script>
