---
import type { Language, Media } from '../../types/content';
import { ui } from '../../i18n/ui';
interface Props { lang: Language; media?: Media; kind?: 'image' | 'video'; ratio?: number; class?: string; label?: string; }
const { lang, media, kind = 'image', ratio = 1.5, class: className = '', label } = Astro.props;
const type = media?.type ?? kind;
---
{media && !media.placeholder && media.src ? (
  type === 'image' ? <img class:list={['media-asset', className]} src={media.src} alt={media.alt[lang]} loading="lazy" style={`aspect-ratio: ${media.ratio}`} /> :
    <video class:list={['media-asset', className]} src={media.src} poster={media.poster} controls muted playsinline aria-label={media.alt[lang]} style={`aspect-ratio: ${media.ratio}`} />
) : (
  <div class:list={['media-placeholder', className]} style={`--media-ratio: ${media?.ratio ?? ratio}`} role="img" aria-label={label ?? ui(lang)[type]}>
    <span class="media-label">{label ?? ui(lang)[type]}</span>
  </div>
)}
