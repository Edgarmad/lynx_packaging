---
import type { Language, Category, Product } from '../../types/content';
import { ui } from '../../i18n/ui';
import ProductCard from './ProductCard.astro';
interface Props { lang: Language; category: Category; products: Product[]; }
const {lang,category,products}=Astro.props;const t=ui(lang);
---
<div class="site-container catalog-layout" data-catalog data-allowed={JSON.stringify(Object.fromEntries(category.filters.map(f=>[f.key,f.values.map(v=>v.id)])))}>
  <aside>
    <details class="filter-panel" open>
      <summary>{t.filters}</summary>
      <form data-filter-form>
        <label class="catalog-search">{lang==='es'?'Buscar producto o modelo':'Search product or model'}<input type="search" name="q" autocomplete="off" data-search-input/></label>
        <button type="reset" class="filter-clear">{t.clear}</button>
        {category.filters.map(filter=><fieldset><legend>{filter.label[lang]}</legend>{filter.values.map(value=><label><input type="checkbox" name={filter.key} value={value.id}/>{value.label[lang]}</label>)}</fieldset>)}
      </form>
    </details>
    <noscript><p>{lang==='es'?'Activa JavaScript para filtrar. Todos los productos están disponibles debajo.':'Enable JavaScript to filter. All products are available below.'}</p></noscript>
  </aside>
  <div><h2 class="sr-only">{t.products}</h2><p class="result-count" aria-live="polite" data-result-count data-lang={lang}>{products.length} {category.status==='demo'?(lang==='es'?'muestras de diseño':'design samples'):(lang==='es'?'productos':'products')}</p>
    <div class="product-grid">{products.map(product=><ProductCard lang={lang} product={product} filterable searchText={[product.title.es,product.title.en,product.modelCode??'',...category.filters.flatMap(filter=>filter.values.filter(value=>product.attributes[filter.key]?.includes(value.id)).flatMap(value=>[value.label.es,value.label.en]))].join(' ')}/>)}</div>
    <p data-empty hidden>{t.noProducts}</p>
    <nav class="catalog-pagination" aria-label={lang==='es'?'Paginación de productos':'Product pagination'} data-pagination hidden>
      <button type="button" data-previous>{lang==='es'?'Anterior':'Previous'}</button>
      <span data-page-count aria-live="polite"></span>
      <button type="button" data-next>{lang==='es'?'Siguiente':'Next'}</button>
    </nav>
  </div>
</div>
<script>
  import { matches, readFilters } from '../../lib/filters';
  import { catalogPage, catalogSearch } from '../../lib/catalog';
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach(root=>{
    const allowed:Record<string,string[]>=JSON.parse(root.dataset.allowed??'{}');
    const form=root.querySelector<HTMLFormElement>('[data-filter-form]');
    const cards=Array.from(root.querySelectorAll<HTMLElement>('[data-product]')).map(element=>({element,attributes:JSON.parse(element.dataset.product??'{}') as Record<string,string[]>}));
    const count=root.querySelector<HTMLElement>('[data-result-count]');const empty=root.querySelector<HTMLElement>('[data-empty]');if(!form)return;
    const search=form.querySelector<HTMLInputElement>('[data-search-input]');
    const pager=root.querySelector<HTMLElement>('[data-pagination]');
    const previous=root.querySelector<HTMLButtonElement>('[data-previous]');
    const next=root.querySelector<HTMLButtonElement>('[data-next]');
    const pageCount=root.querySelector<HTMLElement>('[data-page-count]');
    let currentPage=1;
    const render=(writeUrl:boolean)=>{
      const data=new FormData(form);const selection=Object.fromEntries(Object.keys(allowed).map(key=>[key,data.getAll(key).map(String)]));
      const filtered=cards.filter(card=>matches(card.attributes,selection)&&catalogSearch(card.element.dataset.search??'',search?.value??''));
      const total=filtered.length;const range=catalogPage(String(currentPage),total);currentPage=range.page;
      const shown=new Set(filtered.slice(range.start,range.end));cards.forEach(card=>card.element.hidden=!shown.has(card));
      if(pager)pager.hidden=total<=24;if(previous)previous.disabled=range.page===1;if(next)next.disabled=range.page===range.pages;
      if(pageCount)pageCount.textContent=count?.dataset.lang==='es'?`Página ${range.page} de ${range.pages}`:`Page ${range.page} of ${range.pages}`;
      if(count)count.textContent=`${total} / ${cards.length} ${count.dataset.lang==='es'?'resultados':'results'}`;if(empty)empty.hidden=total!==0;
      if(writeUrl){const url=new URL(location.href);Object.entries(selection).forEach(([key,values])=>{url.searchParams.delete(key);values.forEach(value=>url.searchParams.append(key,value));});url.searchParams.delete('page');if(currentPage>1)url.searchParams.set('page',String(currentPage));url.searchParams.delete('q');if(search?.value.trim())url.searchParams.set('q',search.value.trim());history.replaceState(null,'',url);}
    };
    const restore=()=>{const params=new URLSearchParams(location.search);const selection=readFilters(location.search,allowed);form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(input=>input.checked=selection[input.name]?.includes(input.value)??false);if(search)search.value=params.get('q')??'';currentPage=catalogPage(params.get('page'),cards.length).page;render(false);};
    form.addEventListener('change',()=>{currentPage=1;render(true);});search?.addEventListener('input',()=>{currentPage=1;render(true);});form.addEventListener('submit',event=>event.preventDefault());
    form.addEventListener('reset',event=>{event.preventDefault();form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach(input=>input.checked=false);if(search)search.value='';currentPage=1;render(true);});
    const navigate=(step:number)=>{currentPage+=step;render(true);count?.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};
    previous?.addEventListener('click',()=>navigate(-1));next?.addEventListener('click',()=>navigate(1));window.addEventListener('popstate',restore);restore();
    const details=root.querySelector<HTMLDetailsElement>('details');const mq=window.matchMedia('(max-width: 767px)');const responsive=()=>{if(details)details.open=!mq.matches;};mq.addEventListener('change',responsive);responsive();
  });
</script>
