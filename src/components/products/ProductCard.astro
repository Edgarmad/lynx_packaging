---
import type { Language, Product } from '../../types/content';
import { ui } from '../../i18n/ui';
import { route } from '../../lib/routes';
import MediaPlaceholder from '../ui/MediaPlaceholder.astro';
interface Props { lang: Language; product: Product; filterable?: boolean; searchText?: string; }
const {lang,product,filterable=false,searchText}=Astro.props;
---
<article class="product-card" data-product={filterable?JSON.stringify(product.attributes):undefined} data-search={filterable?(searchText??`${product.title[lang]} ${product.modelCode??''}`):undefined}>
  <a href={route(lang,`products/${product.slug}`)} aria-label={product.title[lang]}><MediaPlaceholder lang={lang} media={product.gallery[0]}/></a>
  <h3><a href={route(lang,`products/${product.slug}`)}>{product.title[lang]}</a></h3>
  {product.status==='demo'&&<p>{ui(lang).demo}</p>}
  {product.kind==='family'&&<p>{lang==='es'?'Fabricación a medida':'Custom manufacturing'}</p>}
  <a class="text-link" href={route(lang,`products/${product.slug}`)}>{ui(lang).viewProduct}<span aria-hidden="true">→</span></a>
</article>
