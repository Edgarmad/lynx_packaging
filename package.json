{
  "name": "lynx-packaging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "validate:data": "tsx scripts/validate-data.ts",
    "check": "astro check",
    "test": "tsx --test src/lib/*.test.ts",
    "build": "npm run validate:data && astro build && tsx scripts/generate-sitemap.ts",
    "stop": "astro dev stop"
  },
  "dependencies": {
    "astro": "7.3.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
